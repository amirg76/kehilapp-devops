# ═════════════════════════════════════════════════════════════════════════════
# .env.example — the ONE secrets/config file the stack reads.
#
#   LOCAL:  cp .env.example .env   (docker-compose.yml reads it automatically)
#   SERVER: copy this to /opt/kehilapp/.env and fill it in, then deploy.
#
# NEVER commit the real .env. Only this .example is committed.
# ═════════════════════════════════════════════════════════════════════════════

# ── Which image to pull (prod compose) ───────────────────────────────────────
# REGISTRY + TAG select the GHCR images CI pushed. Owner must be lowercase.
REGISTRY=ghcr.io/owner
TAG=latest                 # prod=latest, dev box=dev, or pin a git sha

# ── Backend runtime config (matches src/config/env.js) ───────────────────────
LOG_LEVEL=info

# Self-hosted Mongo on this box (default). To use Atlas instead, paste the full
# SRV string here and it overrides the container:
#   MONGO_URI=mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/kehilapp
MONGO_URI=mongodb://mongo:27017/kehilapp

# REQUIRED. Long random string. Generate: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_long_random_string

# S3-compatible object storage for uploads (the backend uses @aws-sdk/client-s3).
BUCKET_NAME=
BUCKET_REGION=eu-central-1
BUCKET_ACCESS_KEY=
BUCKET_SECRET_ACCESS_KEY=

# Comma-separated list of origins allowed to call the API (CORS). Use your real
# https domain(s) in prod.
ALLOWED_ORIGINS=https://kehilapp.example.com

# ── TLS / Caddy (prod only) ──────────────────────────────────────────────────
# The domain Caddy issues a cert for, and the email Let's Encrypt notifies.
DOMAIN=kehilapp.example.com
ACME_EMAIL=you@example.com
