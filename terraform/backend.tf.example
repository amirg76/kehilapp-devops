# ─────────────────────────────────────────────────────────────────────────────
# backend.tf.example — OPTIONAL shared remote state (S3 + DynamoDB lock).
#
# WHY: by default Terraform stores "what I built" in a local terraform.tfstate
# file. If more than one person runs Terraform, or you run it from CI, that
# local file is a problem (it can be lost, or two applies can clash). The fix:
#   • S3 bucket   → holds the state file, versioned + encrypted, shared.
#   • DynamoDB    → a lock so only one `apply` runs at a time.
#
# This is DOCUMENTED, NOT ENFORCED. To turn it on:
#   1. Create the bucket + table ONCE (see the commands below).
#   2. Rename this file to backend.tf and fill in your values.
#   3. Run: terraform init -migrate-state   (moves your local state into S3).
#
# Bootstrap commands (run once, replace <ACCOUNT_ID> and region):
#   aws s3api create-bucket --bucket kehilapp-tfstate-<ACCOUNT_ID> \
#     --region eu-central-1 \
#     --create-bucket-configuration LocationConstraint=eu-central-1
#   aws s3api put-bucket-versioning --bucket kehilapp-tfstate-<ACCOUNT_ID> \
#     --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name kehilapp-tflock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST --region eu-central-1
#
# COST: an almost-empty S3 bucket + a pay-per-request DynamoDB table cost a few
# cents/month at this scale — effectively free.
# ─────────────────────────────────────────────────────────────────────────────

# terraform {
#   backend "s3" {
#     bucket         = "kehilapp-tfstate-<ACCOUNT_ID>"
#     key            = "kehilapp/terraform.tfstate"
#     region         = "eu-central-1"
#     dynamodb_table = "kehilapp-tflock"
#     encrypt        = true
#     # With workspaces, dev/prod state is stored under separate keys automatically:
#     #   env:/prod/kehilapp/terraform.tfstate
#   }
# }
